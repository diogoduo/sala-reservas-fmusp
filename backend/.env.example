# =============================================================================
# Sistema de Reserva de Salas — FMUSP  |  Back-end
# Copie para `.env` e ajuste. NUNCA versione o `.env` real.
# =============================================================================

# --- Aplicação ---------------------------------------------------------------
NODE_ENV=development
PORT=3333
# Fuso usado em TODAS as regras de horário (07:30–22:30, antecedência de 3 dias)
APP_TIMEZONE=America/Sao_Paulo
# URL do front-end (CORS e redirecionamentos pós-login)
FRONTEND_URL=http://localhost:5173
# Em produção o back-end também serve o front compilado (frontend/dist). Só
# precisa disto se a pasta estiver em outro lugar.
# FRONTEND_DIST=

# --- Banco de dados (PostgreSQL) ---------------------------------------------
# Valores iguais aos do docker-compose.yml
DATABASE_URL=postgresql://reservas:reservas@localhost:5432/reservas_fmusp?schema=public

# --- Sessão ------------------------------------------------------------------
# Mínimo de 32 caracteres. Gere com: openssl rand -hex 32
SESSION_SECRET=troque-este-segredo-por-um-valor-aleatorio-longo
SESSION_TTL_HOURS=8
# true em produção (exige HTTPS)
COOKIE_SECURE=false

# --- Autenticação ------------------------------------------------------------
# mock       -> Mock USP local (Dev Mode). Bloqueado quando NODE_ENV=production.
# senhaunica -> Senha Única USP (OAuth 1.0a)
# oidc       -> provedor OIDC/OAuth2 genérico
AUTH_MODE=mock
# Demonstração online (render.yaml): DEMO_MODE=true libera o AUTH_MODE=mock em
# produção, mas só com ACCESS_CODE definido. ACCESS_CODE (mín. 6 caracteres) é
# pedido antes de qualquer tela; vazio = sem código (padrão no dev).
DEMO_MODE=false
ACCESS_CODE=
# Domínios de e-mail autorizados (separados por vírgula)
ALLOWED_EMAIL_DOMAINS=usp.br,fm.usp.br,hc.fm.usp.br
# E-mails promovidos a ADMIN no primeiro login (separados por vírgula)
ADMIN_EMAILS=admin@fm.usp.br

# Senha Única USP — consumidor cadastrado em
# https://uspdigital.usp.br/adminws/oauthConsumidorAcessar
SENHAUNICA_KEY=
SENHAUNICA_SECRET=
SENHAUNICA_CALLBACK_ID=
SENHAUNICA_BASE_URL=https://uspdigital.usp.br/wsusuario/oauth
# Ver aviso em src/auth/senhaunica.ts — path não confirmado com fonte oficial, ajuste se necessário
SENHAUNICA_USER_INFO_PATH=/dadosusuario

# OIDC genérico (alternativa, se a instituição disponibilizar)
OIDC_ISSUER=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_REDIRECT_URI=http://localhost:3333/api/auth/oidc/callback

# --- E-mail (Nodemailer) -----------------------------------------------------
# Em dev, aponta para o Mailpit do docker-compose (http://localhost:8025)
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM="Reserva de Salas FMUSP <no-reply@fm.usp.br>"
# false = não envia e-mails, só registra no log (demonstração sem SMTP)
MAIL_ENABLED=true
# Envio pela API do Brevo (plano grátis, 300 e-mails/dia), por HTTPS em vez de
# SMTP. O remetente de MAIL_FROM precisa estar verificado no Brevo. Vazio = SMTP.
BREVO_API_KEY=
# Demonstração: todo e-mail vai para MAIL_REDIRECT_TO (o assunto diz para quem
# iria), menos os endereços de MAIL_REDIRECT_EXCEPT (ex.: o e-mail real da TI).
# Com DEMO_MODE=true e sem MAIL_REDIRECT_TO, as contas de teste não recebem nada.
MAIL_REDIRECT_TO=
MAIL_REDIRECT_EXCEPT=
# Equipe de TI/Infraestrutura: recebe aviso quando uma reserva aprovada pede recursos técnicos
TI_EMAIL_ADDRESS=ti@fm.usp.br
