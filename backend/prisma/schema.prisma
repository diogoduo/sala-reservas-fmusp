// =============================================================================
// Sistema de Reserva de Salas — FMUSP
// Nomes no banco em snake_case (via @map/@@map); no código, camelCase.
//
// Regras que o Prisma NÃO consegue expressar (CHECKs, exclusão de sobreposição
// via btree_gist) ficam em migrations/20260921000100_db_constraints.
// =============================================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ----------------------------------------------------------------------------
// Enums
// ----------------------------------------------------------------------------

enum UserRole {
  USER // Solicitante
  ADMIN // SAD — Serviço de Apoio Didático
  NUCEV // Núcleo de Eventos: consulta tudo; no módulo de Eventos, cuida da análise ao encerramento

  @@map("user_role")
}

/// Que tipos de atividade a pessoa pode pedir (Fase 9). Graduação, Pós-Graduação
/// e Defesa só com a permissão; Cultura e Extensão e Concurso vêm ligados para
/// todos (o SAD pode tirar, ex.: de quem só cuida das defesas). Reunião não tem
/// permissão: todos pedem. O SAD concede e retira na tela Pessoas.
enum Permission {
  REQUEST_UNDERGRADUATE // pedir reservas de Graduação
  REQUEST_GRADUATE // pedir reservas de Pós-Graduação
  REQUEST_DEFENSE // pedir reservas de Defesa/Dissertação
  REQUEST_CULTURE_EXTENSION // pedir reservas de Cultura e Extensão (padrão)
  REQUEST_PUBLIC_EXAM // pedir reservas de Concurso (padrão)

  @@map("permission")
}

enum RoomType {
  AUDITORIUM // Auditório
  LABORATORY // Laboratório
  CLASSROOM // Sala de Aula
  MEETING_ROOM // Sala de Reunião
  MULTIPURPOSE // Espaço Multiuso
  COMPUTER_LAB // Sala de Informática
  BOARD_ROOM // Congregação/CTA
  THEATER // Teatro
  /// Átrio, hall, terraço, copa (Portaria 2794, Art. 3º): coffee break, exposição,
  /// credenciamento. Pode ficar sem capacidade mesmo Ativa (ex.: átrio).
  SUPPORT_AREA // Área de apoio

  @@map("room_type")
}

/// Tipo de cadeira, como na planilha do SAD (uma sala pode ter mais de um).
enum SeatType {
  SCHOOL // Escolar
  UNIVERSITY_FIXED // Universitária fixa
  UNIVERSITY_MOBILE // Universitária móvel

  @@map("seat_type")
}

enum RoomStatus {
  ACTIVE // Ativa
  MAINTENANCE // Em Manutenção
  INACTIVE // Inativa

  @@map("room_status")
}

enum ReservationStatus {
  PENDING // Pendente (já pré-bloqueia o horário)
  APPROVED // Aprovada
  REJECTED // Rejeitada (exige justificativa)
  CANCELLED // Cancelada

  @@map("reservation_status")
}

enum ActivityType {
  UNDERGRADUATE // Graduação
  GRADUATE // Pós-Graduação
  CULTURE_EXTENSION // Cultura e Extensão
  PUBLIC_EXAM // Concurso
  DEFENSE // Defesa/Dissertação
  ADMINISTRATIVE // Reunião / Administrativo (Portaria 2793, Art. 7º, itens 3 e 7)

  @@map("activity_type")
}

// ----------------------------------------------------------------------------
// Usuários
// ----------------------------------------------------------------------------

model User {
  id        String   @id @default(uuid()) @db.Uuid
  uspNumber String?  @unique @map("usp_number") // nº USP (loginUsuario da Senha Única)
  name      String
  email     String   @unique // sempre minúsculo; domínio validado no app e no banco
  role        UserRole     @default(USER)
  permissions Permission[] @default([REQUEST_CULTURE_EXTENSION, REQUEST_PUBLIC_EXAM])
  icalToken   String?      @unique @map("ical_token") // segredo do feed .ics; gerado sob demanda
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  reservations          Reservation[]       @relation("ReservationRequester")
  reviewedReservations  Reservation[]       @relation("ReservationReviewer")
  cancelledReservations Reservation[]       @relation("ReservationCanceller")
  series                ReservationSeries[]
  roomBlocks            RoomBlock[]
  noShowsMarked         Reservation[]       @relation("ReservationNoShowMarker")
  sanctions             UserSanction[]      @relation("SanctionedUser")
  sanctionsApplied      UserSanction[]      @relation("SanctionApplier")
  sanctionsLifted       UserSanction[]      @relation("SanctionLifter")
  auditLogs             AuditLog[]
  events                Event[]
  assignedTasks         OperationalTask[]   @relation("TaskAssignee")
  createdTasks          OperationalTask[]   @relation("TaskCreator")

  @@map("users")
}

// ----------------------------------------------------------------------------
// Salas e recursos
// ----------------------------------------------------------------------------

model Room {
  id             String     @id @default(uuid()) @db.Uuid
  name           String // nome/número da sala
  building       String // prédio/bloco
  floor          String // andar/pavimento (texto: "Térreo", "2º andar"...)
  /// Cadeiras da plateia. Pode ficar sem valor ("a definir") só em sala que
  /// não está Ativa (ex.: em reforma) ou em área de apoio sem limite cadastrado
  /// (ex.: átrio) — CHECK rooms_active_capacity_check.
  capacity       Int?
  roomType       RoomType   @map("room_type")
  status         RoomStatus @default(ACTIVE)
  /// Cadeiras de rodinha / professor / bancos, além das cadeiras da plateia (capacity).
  extraSeats     Int?       @map("extra_seats")
  /// Largura × comprimento, como na planilha da FMUSP (ex.: "10,30 × 9,60 m").
  dimensions     String?
  /// Outros equipamentos da sala, em texto livre. Só o SAD vê.
  equipmentNotes String?    @map("equipment_notes")
  seatTypes      SeatType[] @default([]) @map("seat_types")
  /// Porta de 900 mm.
  wideDoor       Boolean    @default(false) @map("wide_door")
  /// Sala preparada para atendimento especial.
  specialNeeds   Boolean    @default(false) @map("special_needs")
  /// Pode receber coffee break (Portaria 2794, Art. 5º: nas salas de aula, só
  /// as de uso interativo; doc. SAD/NUCEV §6: áreas de apoio). O SAD configura.
  coffeeAllowed         Boolean @default(false) @map("coffee_allowed")
  /// Máximo de pessoas no coffee break. Vazio = a capacidade do espaço.
  coffeeCapacity        Int?    @map("coffee_capacity")
  /// "Indicado para eventos acima de N pessoas" (ex.: átrios, acima de 250).
  /// É orientação de uso, não capacidade máxima.
  recommendedAbove      Int?    @map("recommended_above")
  /// O uso depende de autorização da Diretoria Executiva (átrios, Portaria 2747/2025).
  requiresBoardApproval Boolean @default(false) @map("requires_board_approval")
  /// Regras e condições de uso, em texto, para quem consulta o espaço.
  usageRules            String? @map("usage_rules")
  /// Categoria de preço (Portaria 2794). Nula = valor a definir.
  priceCategoryId       String? @map("price_category_id") @db.Uuid
  createdAt      DateTime   @default(now()) @map("created_at") @db.Timestamptz(3)

  priceCategory PriceCategory? @relation(fields: [priceCategoryId], references: [id], onDelete: SetNull)
  resources    RoomResource[]
  photos       RoomPhoto[]
  reservations Reservation[]
  series       ReservationSeries[]
  blocks       RoomBlock[]
  eventSpaces  EventSpaceRequest[]

  @@unique([building, floor, name])
  @@index([status])
  @@map("rooms")
}

// ----------------------------------------------------------------------------
// Preços (Fase 9, bloco 4 — Portaria 2794)
// ----------------------------------------------------------------------------

enum PriceUnit {
  HOUR // por hora
  DAY // por dia

  @@map("price_unit")
}

/// O que se cobra: o Teatro, os anfiteatros, as salas de aula e de reunião e cada
/// área de apoio. O espaço aponta para a categoria; o valor fica na tabela vigente.
model PriceCategory {
  id        String    @id @default(uuid()) @db.Uuid
  name      String    @unique
  unit      PriceUnit
  /// Espaço didático (Art. 2º): valem a cobrança mínima e as horas de preparação.
  didactic  Boolean   @default(false)
  position  Int       @default(0)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  rooms       Room[]
  entries     PriceEntry[]
  eventSpaces EventSpaceRequest[]

  @@map("price_categories")
}

/// Tabela de preços com vigência. O reajuste anual é uma tabela nova, a partir de
/// uma data; a anterior continua guardada (os orçamentos usam a da data do evento).
model PriceTable {
  id                           String   @id @default(uuid()) @db.Uuid
  name                         String
  validFrom                    DateTime @unique @map("valid_from") @db.Date
  /// Art. 2º: cobrança mínima dos espaços didáticos, em horas.
  minimumHours                 Int      @default(2) @map("minimum_hours")
  /// Art. 2º §1º: horas de preparação antes e depois, em cada dia, nos espaços didáticos.
  prepHoursBefore              Int      @default(1) @map("prep_hours_before")
  prepHoursAfter               Int      @default(1) @map("prep_hours_after")
  /// Art. 5º §2º: adicional nas salas de aula com coffee break.
  coffeeSurchargePercent       Int      @default(20) @map("coffee_surcharge_percent")
  /// Art. 4º III: desconto para FMUSP/HC, USP, SES e Instituto Adolfo Lutz.
  institutionalDiscountPercent Int      @default(25) @map("institutional_discount_percent")
  notes                        String?
  createdAt                    DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  entries PriceEntry[]

  @@map("price_tables")
}

model PriceEntry {
  tableId     String @map("table_id") @db.Uuid
  categoryId  String @map("category_id") @db.Uuid
  /// Em centavos. Nulo = a definir.
  amountCents Int?   @map("amount_cents")

  table    PriceTable    @relation(fields: [tableId], references: [id], onDelete: Cascade)
  category PriceCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@id([tableId, categoryId])
  @@map("price_entries")
}

model Resource {
  id               String   @id @default(uuid()) @db.Uuid
  name             String   @unique
  description      String?
  /// O formulário de solicitação pede a quantidade (ex.: Computador, Chromebook).
  requestsQuantity Boolean  @default(false) @map("requests_quantity")
  /// Aparece no formulário de reserva. Itens de infraestrutura (nobreak, splitter…)
  /// ficam só no inventário das salas.
  requestable      Boolean  @default(true)
  /// Quando preenchido, o formulário pede um detalhe usando este texto de
  /// exemplo (ex.: "Ex.: Zoom, Teams, Google Meet" na Webconferência).
  detailPrompt     String?  @map("detail_prompt")
  /// Se não estiver vazia, o detalhe vira uma escolha entre estas opções, e
  /// passa a ser obrigatório (ex.: plataforma liberada no Bloqueio de internet).
  detailOptions    String[] @default([]) @map("detail_options")

  rooms RoomResource[]

  @@map("resources")
}

model RoomResource {
  roomId     String  @map("room_id") @db.Uuid
  resourceId String  @map("resource_id") @db.Uuid
  quantity   Int     @default(1)
  /// Modelo e patrimônio(s) do equipamento nesta sala — só o SAD vê.
  model      String?
  assetTags  String? @map("asset_tags")

  room     Room     @relation(fields: [roomId], references: [id], onDelete: Cascade)
  resource Resource @relation(fields: [resourceId], references: [id], onDelete: Cascade)

  @@id([roomId, resourceId])
  @@map("room_resources")
}

/// Foto de uma sala. As versões webp "thumb" e "large" (geradas no upload)
/// ficam no próprio banco: o app não depende de disco persistente no servidor.
model RoomPhoto {
  id         String   @id @default(uuid()) @db.Uuid
  roomId     String   @map("room_id") @db.Uuid
  caption    String?
  /// Ordem na galeria; a de menor posição é a capa.
  position   Int      @default(0)
  width      Int
  height     Int
  /// Arquivo de origem, quando veio do import (evita importar a mesma foto duas vezes).
  sourceName String?  @map("source_name")
  /// WebP de até 720 px (cards e miniaturas) e de até 1920 px (galeria).
  /// Nunca vêm nas listagens (roomPhotosInclude seleciona só os metadados).
  thumb      Bytes
  large      Bytes
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  room Room @relation(fields: [roomId], references: [id], onDelete: Cascade)

  @@unique([roomId, sourceName])
  @@index([roomId, position])
  @@map("room_photos")
}

// ----------------------------------------------------------------------------
// Reservas
// ----------------------------------------------------------------------------

/// Cabeçalho de uma reserva recorrente. As ocorrências são materializadas como
/// linhas em `reservations` (com series_id), o que permite validar conflito,
/// aprovar e cancelar data a data.
model ReservationSeries {
  id          String    @id @default(uuid()) @db.Uuid
  userId      String    @map("user_id") @db.Uuid
  roomId      String?   @map("room_id") @db.Uuid
  title       String
  description String
  rrule       String    @map("rrule_expression") // RFC 5545, sem DTSTART (ex.: FREQ=WEEKLY;BYDAY=MO)
  startTime   DateTime  @map("start_time") @db.Timestamptz(3) // DTSTART: início da 1ª ocorrência
  endTime     DateTime  @map("end_time") @db.Timestamptz(3) // fim da 1ª ocorrência (define a duração)
  untilDate   DateTime? @map("until_date") @db.Date
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  user         User          @relation(fields: [userId], references: [id], onDelete: Restrict)
  room         Room?         @relation(fields: [roomId], references: [id], onDelete: Restrict)
  reservations Reservation[]

  @@index([userId])
  @@map("reservation_series")
}

model Reservation {
  id                    String            @id @default(uuid()) @db.Uuid
  /// Nº de protocolo do pedido ("000123/2026"), gerado ao registrar (Portaria
  /// 2793, Art. 8º §1º, b). As datas de uma série compartilham o mesmo número.
  protocol              String
  seriesId              String?           @map("series_id") @db.Uuid
  userId                String            @map("user_id") @db.Uuid
  /// Sala pretendida/alocada. Nula quando o solicitante não indicou preferência;
  /// nesse caso nada é pré-bloqueado e o Admin precisa alocar antes de aprovar.
  roomId                String?           @map("room_id") @db.Uuid
  title                 String
  description           String
  /// Tipo de atividade e os campos específicos do formulário daquele tipo
  /// (validados por zod em src/schemas/reservation.ts). Nulos nas solicitações
  /// feitas antes dos formulários por tipo.
  activityType          ActivityType?     @map("activity_type")
  activityDetails       Json?             @map("activity_details")
  expectedAttendees     Int               @map("expected_attendees")
  requestedResources    Json              @default("[]") @map("requested_resources") // [{ resourceId, quantity?, detail? }]
  supportNotes          String?           @map("support_notes")
  termsAccepted         Boolean           @map("terms_accepted")
  /// Início e fim do uso do espaço. O início inclui a montagem (setupMinutes).
  startTime             DateTime          @map("start_time") @db.Timestamptz(3)
  endTime               DateTime          @map("end_time") @db.Timestamptz(3)
  /// Montagem antes da atividade, reservada junto (Portaria 2793, Art. 19):
  /// a atividade começa em startTime + setupMinutes.
  setupMinutes          Int               @default(0) @map("setup_minutes")
  /// Domingo, feriado, ponto facultativo ou fora das 07h–22h: só o SAD reserva,
  /// com autorização da Divisão Acadêmica (Art. 6º §1º). Libera o CHECK de horário.
  outsideRegularHours   Boolean           @default(false) @map("outside_regular_hours")
  /// Compromisso de não haver comércio nem consumo de bebidas alcoólicas (Art. 23).
  noAlcoholCommitment   Boolean           @default(false) @map("no_alcohol_commitment")
  /// Haverá coffee break/alimentação (Portaria 2794, Art. 5º: só em algumas salas).
  coffeeBreak           Boolean           @default(false) @map("coffee_break")
  /// Conferência do SAD ao confirmar Cultura e Extensão (CCEx, Divisão
  /// Acadêmica, taxa paga ou isenção — Art. 20 §3º, Art. 14 §3º, Art. 21 §2º).
  approvalChecklist     Json?             @map("approval_checklist")
  /// Não comparecimento sem cancelamento, registrado pelo SAD (Art. 9º §2º).
  noShowAt              DateTime?         @map("no_show_at") @db.Timestamptz(3)
  noShowById            String?           @map("no_show_by_id") @db.Uuid
  status                ReservationStatus @default(PENDING)
  rejectionReason       String?           @map("rejection_reason")
  reviewedById          String?           @map("reviewed_by_id") @db.Uuid
  reviewedAt            DateTime?         @map("reviewed_at") @db.Timestamptz(3)
  cancelledAt           DateTime?         @map("cancelled_at") @db.Timestamptz(3)
  /// Quem cancelou: o próprio solicitante ou alguém do SAD (que precisa dar o motivo).
  cancelledById         String?           @map("cancelled_by_id") @db.Uuid
  cancellationReason    String?           @map("cancellation_reason")
  /// Última alteração feita pelo SAD. Diferente da do solicitante, não devolve a
  /// reserva para análise: uma aprovada continua aprovada.
  modifiedByAdminAt     DateTime?         @map("modified_by_admin_at") @db.Timestamptz(3)
  /// Quando o solicitante alterou a reserva pela última vez. Alterar devolve a
  /// reserva para análise (PENDING); o SAD vê essas na aba "Alteradas".
  modifiedByRequesterAt DateTime?         @map("modified_by_requester_at") @db.Timestamptz(3)
  /// Como a reserva estava antes da alteração (status, horário, sala…), para o
  /// SAD comparar. Guarda o último estado revisado, não as edições intermediárias.
  previousSnapshot      Json?             @map("previous_snapshot")
  /// Evento a que a reserva pertence (Fase 12): o SAD pré-reserva os espaços do evento.
  eventId               String?           @map("event_id") @db.Uuid
  /// Pré-reserva de evento: segura a sala até aqui. Vencida, o sistema cancela e
  /// libera a sala; confirmado o evento, fica nula (reserva efetivada).
  preReservedUntil      DateTime?         @map("pre_reserved_until") @db.Timestamptz(3)
  createdAt             DateTime          @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt             DateTime          @updatedAt @map("updated_at") @db.Timestamptz(3)

  event       Event?             @relation(fields: [eventId], references: [id], onDelete: SetNull)
  series      ReservationSeries? @relation(fields: [seriesId], references: [id], onDelete: SetNull)
  user        User               @relation("ReservationRequester", fields: [userId], references: [id], onDelete: Restrict)
  room        Room?              @relation(fields: [roomId], references: [id], onDelete: Restrict)
  reviewedBy  User?              @relation("ReservationReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)
  cancelledBy User?              @relation("ReservationCanceller", fields: [cancelledById], references: [id], onDelete: SetNull)
  noShowBy    User?              @relation("ReservationNoShowMarker", fields: [noShowById], references: [id], onDelete: SetNull)

  @@index([roomId, startTime])
  @@index([userId, startTime])
  @@index([status])
  @@index([seriesId])
  @@index([protocol])
  @@index([eventId])
  @@map("reservations")
}

// ----------------------------------------------------------------------------
// Sanções aos solicitantes (Portaria 2793, Art. 9º §2º, Art. 11, Art. 17 e Art. 22)
// ----------------------------------------------------------------------------

enum SanctionType {
  WARNING // Advertência
  FINE // Multa
  SUSPENSION // Suspensão/bloqueio de novas reservas

  @@map("sanction_type")
}

model UserSanction {
  id          String       @id @default(uuid()) @db.Uuid
  userId      String       @map("user_id") @db.Uuid
  type        SanctionType
  reason      String
  /// Suspensão: último dia (inclusive). Nulo = até a regularização.
  until       DateTime?    @db.Date
  createdById String       @map("created_by_id") @db.Uuid
  createdAt   DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  /// Suspensão retirada antes do fim.
  liftedAt    DateTime?    @map("lifted_at") @db.Timestamptz(3)
  liftedById  String?      @map("lifted_by_id") @db.Uuid

  user      User  @relation("SanctionedUser", fields: [userId], references: [id], onDelete: Cascade)
  createdBy User  @relation("SanctionApplier", fields: [createdById], references: [id], onDelete: Restrict)
  liftedBy  User? @relation("SanctionLifter", fields: [liftedById], references: [id], onDelete: SetNull)

  @@index([userId, createdAt])
  @@map("user_sanctions")
}

// ----------------------------------------------------------------------------
// Notebooks do SAD (controle de patrimônio; não são reservados pelo sistema)
// ----------------------------------------------------------------------------

enum NotebookLocation {
  SAD // Backup no SAD
  NIT // Transferido para o NIT (TI da faculdade)

  @@map("notebook_location")
}

model Notebook {
  id        String           @id @default(uuid()) @db.Uuid
  assetTag  String           @unique @map("asset_tag")
  model     String?
  location  NotebookLocation
  notes     String?
  createdAt DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime         @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@map("notebooks")
}

// ----------------------------------------------------------------------------
// Regulamento (portarias) — aceito no "Li e concordo" do formulário. O SAD
// edita o texto e anexa os PDFs pela própria tela.
// ----------------------------------------------------------------------------

/// Linha única (id = 1, garantido por CHECK).
model Regulation {
  id          Int      @id @default(1)
  title       String
  /// Texto simples: parágrafos, "## título" e listas com "- ".
  body        String
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)
  updatedById String?  @map("updated_by_id") @db.Uuid

  @@map("regulation")
}

model RegulationFile {
  id        String   @id @default(uuid()) @db.Uuid
  fileName  String   @map("file_name")
  mimeType  String   @map("mime_type")
  size      Int
  data      Bytes
  position  Int      @default(0)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  @@map("regulation_files")
}

/// Bloqueio administrativo/manutenção de uma sala em um intervalo.
model RoomBlock {
  id          String   @id @default(uuid()) @db.Uuid
  roomId      String   @map("room_id") @db.Uuid
  createdById String   @map("created_by_id") @db.Uuid
  reason      String
  startTime   DateTime @map("start_time") @db.Timestamptz(3)
  endTime     DateTime @map("end_time") @db.Timestamptz(3)
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  room      Room @relation(fields: [roomId], references: [id], onDelete: Restrict)
  createdBy User @relation(fields: [createdById], references: [id], onDelete: Restrict)

  @@index([roomId, startTime])
  @@map("room_blocks")
}

// ----------------------------------------------------------------------------
// Histórico geral (Fase 9): quem fez o quê, quando, e o que mudou. Gravado na
// mesma transação da alteração (src/audit/log.ts); o sistema só acrescenta
// linhas, nunca altera nem apaga.
// ----------------------------------------------------------------------------

model AuditLog {
  id         String   @id @default(uuid()) @db.Uuid
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  /// Quem fez. Nulo = o próprio sistema (ou a pessoa foi excluída: o nome fica em actorName).
  actorId    String?  @map("actor_id") @db.Uuid
  actorName  String?  @map("actor_name")
  /// Ex.: "reservation.approve", "room.update" (lista em src/audit/log.ts).
  action     String
  /// "reservation", "room", "resource", "sanction", "regulation", "notebook", "user".
  entityType String   @map("entity_type")
  /// Reservas: o protocolo (as datas de uma série compartilham o número); demais: o id.
  entityId   String   @map("entity_id")
  /// Texto para a lista, gravado na hora (ex.: "000123/2026 — Aula de Anatomia").
  label      String?
  /// Só os campos que mudaram: { campo: { from, to } }.
  changes    Json?
  /// Contexto da ação: datas afetadas, motivo, escopo…
  details    Json?

  actor User? @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([entityType, entityId, createdAt])
  @@index([createdAt])
  @@index([actorId, createdAt])
  @@map("audit_logs")
}

// ----------------------------------------------------------------------------
// Eventos (Fases 11 a 13): o solicitante pede vários dias e espaços; o NUCEV
// analisa e orça; o SAD escolhe as salas, pré-reserva e confirma.
// ----------------------------------------------------------------------------

enum EventStatus {
  SUBMITTED // Recebido: aguardando a análise do NUCEV
  IN_REVIEW // Em análise
  QUOTE_SENT // Orçamento enviado ao solicitante
  CHANGES_REQUESTED // O solicitante pediu alteração
  QUOTE_APPROVED // Orçamento aprovado pelo solicitante
  PRE_RESERVED // Espaços pré-reservados pelo SAD, com validade
  PAYMENT_SUBMITTED // Comprovante enviado: o NUCEV confere
  PAYMENT_VALIDATED // Pagamento validado: o SAD confirma a reserva
  CONFIRMED // Reserva confirmada ("em andamento" e "finalizado" vêm das datas)
  CANCELLED // Cancelado
  REJECTED // Recusado
  EXPIRED // A pré-reserva venceu sem pagamento

  @@map("event_status")
}

model Event {
  id                 String      @id @default(uuid()) @db.Uuid
  /// "EV-000001/2026", da sequência event_protocol_seq.
  protocol           String      @unique
  userId             String      @map("user_id") @db.Uuid
  title              String
  /// Tipo, como no formulário de Cultura e Extensão (Congresso, Cursos, Solenidade…).
  kind               String
  /// Objetivo e programação.
  description        String
  targetAudience     String      @map("target_audience")
  expectedAttendees  Int         @map("expected_attendees")
  /// Entidade organizadora (Portaria 2793, Art. 4º).
  entity             String
  /// Unidade com desconto institucional (Portaria 2794, Art. 4º III), pela entidade.
  institutional      Boolean
  hasRegistrationFee Boolean     @map("has_registration_fee")
  sponsored          Boolean
  responsible        String
  responsibleContact String      @map("responsible_contact")
  department         String
  coffeeBreak        Boolean     @default(false) @map("coffee_break")
  coffeeAttendees    Int?        @map("coffee_attendees")
  /// Equipamentos e infraestrutura pedidos (texto).
  infrastructure     String?
  notes              String?
  /// Orçamento estimado quando o pedido foi enviado (motor da Fase 10).
  estimate           Json?
  status             EventStatus @default(SUBMITTED)
  /// Fase 12: responsável no NUCEV (quem iniciou a análise). Nome guardado na hora.
  assigneeId         String?     @map("assignee_id") @db.Uuid
  assigneeName       String?     @map("assignee_name")
  /// Validade da pré-reserva definida pelo SAD; nula sem pré-reserva ou depois da confirmação.
  preReservedUntil   DateTime?   @map("pre_reserved_until") @db.Timestamptz(3)
  rejectionReason    String?     @map("rejection_reason")
  /// Fase 13: valor esperado (do orçamento aprovado) e as orientações enviadas na hora.
  paymentExpectedCents   Int?      @map("payment_expected_cents")
  paymentInstructions    String?   @map("payment_instructions")
  paymentRequestedAt     DateTime? @map("payment_requested_at") @db.Timestamptz(3)
  paymentValidatedAt     DateTime? @map("payment_validated_at") @db.Timestamptz(3)
  paymentValidatedByName String?   @map("payment_validated_by_name")
  confirmedAt            DateTime? @map("confirmed_at") @db.Timestamptz(3)
  confirmedByName        String?   @map("confirmed_by_name")
  /// Fase 16: encerramento depois do último dia ("Finalizado"), com o balanço.
  closedAt               DateTime? @map("closed_at") @db.Timestamptz(3)
  closedByName           String?   @map("closed_by_name")
  closingNotes           String?   @map("closing_notes")
  actualAttendees        Int?      @map("actual_attendees")
  cancelledAt        DateTime?   @map("cancelled_at") @db.Timestamptz(3)
  cancellationReason String?     @map("cancellation_reason")
  createdAt          DateTime    @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt          DateTime    @updatedAt @map("updated_at") @db.Timestamptz(3)

  user           User                 @relation(fields: [userId], references: [id], onDelete: Restrict)
  days           EventDay[]
  spaces         EventSpaceRequest[]
  reservations   Reservation[]
  quotes         EventQuote[]
  messages       EventMessage[]
  authorizations EventAuthorization[]
  notices        EventNotice[]
  receipts       EventReceipt[]
  plan           EventPlan?
  schedule       EventScheduleItem[]
  people         EventPerson[]
  vehicles       EventVehicle[]
  tasks          OperationalTask[]

  @@index([status, createdAt])
  @@index([userId, createdAt])
  @@map("events")
}

/// Um dia do evento: o horário da atividade e a montagem e desmontagem.
model EventDay {
  id              String   @id @default(uuid()) @db.Uuid
  eventId         String   @map("event_id") @db.Uuid
  date            DateTime @db.Date
  startTime       DateTime @map("start_time") @db.Timestamptz(3)
  endTime         DateTime @map("end_time") @db.Timestamptz(3)
  setupMinutes    Int      @default(0) @map("setup_minutes")
  teardownMinutes Int      @default(0) @map("teardown_minutes")

  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@unique([eventId, date])
  @@map("event_days")
}

/// O que o solicitante pede: N espaços de uma categoria ("10 salas para 90
/// pessoas") ou um espaço pelo nome (Teatro, Átrio), em todos ou em alguns dias.
model EventSpaceRequest {
  id              String     @id @default(uuid()) @db.Uuid
  eventId         String     @map("event_id") @db.Uuid
  position        Int        @default(0)
  priceCategoryId String?    @map("price_category_id") @db.Uuid
  roomId          String?    @map("room_id") @db.Uuid
  count           Int        @default(1)
  /// Pessoas por espaço (só no pedido por categoria).
  minCapacity     Int?       @map("min_capacity")
  /// "Sala principal", "Coffee break", "Credenciamento"…
  purpose         String?
  coffeeInRoom    Boolean    @default(false) @map("coffee_in_room")
  /// Dias de uso; vazio = todos os dias do evento.
  dates           DateTime[] @db.Date

  event         Event          @relation(fields: [eventId], references: [id], onDelete: Cascade)
  priceCategory PriceCategory? @relation(fields: [priceCategoryId], references: [id], onDelete: SetNull)
  room          Room?          @relation(fields: [roomId], references: [id], onDelete: SetNull)

  @@index([eventId])
  @@map("event_space_requests")
}

enum QuoteStatus {
  SENT // Enviado ao solicitante, aguardando resposta
  APPROVED // Aprovado pelo solicitante
  REJECTED // Recusado pelo solicitante
  CHANGES_REQUESTED // O solicitante pediu alteração
  SUPERSEDED // Substituído por uma versão nova

  @@map("quote_status")
}

/// Orçamento emitido pelo NUCEV (Fase 12). Cada envio é uma versão, com o cálculo
/// e os preços usados na hora: mudar a tabela depois não altera o que foi enviado.
model EventQuote {
  id              String      @id @default(uuid()) @db.Uuid
  eventId         String      @map("event_id") @db.Uuid
  version         Int
  /// Resultado do motor (linhas, regras, tabela) no momento do envio.
  estimate        Json
  totalCents      Int         @map("total_cents")
  exemptionReason String?     @map("exemption_reason")
  notes           String?
  status          QuoteStatus @default(SENT)
  createdAt       DateTime    @default(now()) @map("created_at") @db.Timestamptz(3)
  createdById     String?     @map("created_by_id") @db.Uuid
  createdByName   String?     @map("created_by_name")
  decidedAt       DateTime?   @map("decided_at") @db.Timestamptz(3)
  decidedByName   String?     @map("decided_by_name")
  decisionNote    String?     @map("decision_note")

  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@unique([eventId, version])
  @@map("event_quotes")
}

/// Conversa do evento entre o solicitante, o SAD e o NUCEV.
model EventMessage {
  id         String   @id @default(uuid()) @db.Uuid
  eventId    String   @map("event_id") @db.Uuid
  authorId   String?  @map("author_id") @db.Uuid
  authorName String   @map("author_name")
  /// Papel de quem escreveu, na hora (USER, ADMIN, NUCEV).
  authorRole String   @map("author_role")
  body       String
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@index([eventId, createdAt])
  @@map("event_messages")
}

enum AuthorizationStatus {
  PENDING // Aguardando a Diretoria
  AUTHORIZED // Autorizado
  DENIED // Negado

  @@map("authorization_status")
}

/// Pedido de autorização à Diretoria Executiva (átrios). A Diretoria responde
/// pelo link do e-mail, sem login (o token é o segredo do link).
model EventAuthorization {
  id              String              @id @default(uuid()) @db.Uuid
  eventId         String              @map("event_id") @db.Uuid
  token           String              @unique
  recipient       String
  /// Espaços que dependem da autorização, em texto.
  spaces          String
  note            String?
  status          AuthorizationStatus @default(PENDING)
  requestedAt     DateTime            @default(now()) @map("requested_at") @db.Timestamptz(3)
  requestedByName String?             @map("requested_by_name")
  respondedAt     DateTime?           @map("responded_at") @db.Timestamptz(3)
  responseNote    String?             @map("response_note")

  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@index([eventId])
  @@map("event_authorizations")
}

/// E-mails do evento: o que o sistema enviou (ou enviaria, com o e-mail
/// desligado, como na demonstração). A tela do evento mostra cada um.
model EventNotice {
  id        String    @id @default(uuid()) @db.Uuid
  eventId   String    @map("event_id") @db.Uuid
  to        String[]
  subject   String
  body      String
  link      String?
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  sentAt    DateTime? @map("sent_at") @db.Timestamptz(3)

  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@index([eventId, createdAt])
  @@map("event_notices")
}

enum ReceiptStatus {
  PENDING // Aguardando o NUCEV conferir
  VALIDATED // Pagamento validado
  REFUSED // Recusado (o solicitante envia outro)

  @@map("receipt_status")
}

/// Comprovante de pagamento do evento (Fase 13). O envio sozinho não confirma
/// nada: o NUCEV confere e o SAD confirma a reserva.
model EventReceipt {
  id             String        @id @default(uuid()) @db.Uuid
  eventId        String        @map("event_id") @db.Uuid
  fileName       String        @map("file_name")
  mimeType       String        @map("mime_type")
  size           Int
  data           Bytes
  uploadedAt     DateTime      @default(now()) @map("uploaded_at") @db.Timestamptz(3)
  uploadedByName String        @map("uploaded_by_name")
  status         ReceiptStatus @default(PENDING)
  reviewedAt     DateTime?     @map("reviewed_at") @db.Timestamptz(3)
  reviewedByName String?       @map("reviewed_by_name")
  reviewNote     String?       @map("review_note")

  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@index([eventId, uploadedAt])
  @@map("event_receipts")
}

/// Textos que a equipe edita sem mexer no código (Fase 13: as orientações de
/// pagamento dos eventos).
model AppSetting {
  key           String   @id
  value         String
  updatedAt     DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)
  updatedByName String?  @map("updated_by_name")

  @@map("app_settings")
}

// ---------------------------------------------------------------------------
// Fase 16 — organização do evento confirmado (documento SAD/NUCEV, 5.1)
// ---------------------------------------------------------------------------

/// Logística do evento: buffet, estacionamento, estrutura, equipamentos e observações.
model EventPlan {
  eventId        String   @id @map("event_id") @db.Uuid
  buffetNeeded   Boolean  @default(false) @map("buffet_needed")
  buffetDetails  String?  @map("buffet_details")
  parkingNeeded  Boolean  @default(false) @map("parking_needed")
  parkingSpots   Int?     @map("parking_spots")
  parkingDetails String?  @map("parking_details")
  structure      String?
  equipment      String?
  notes          String?
  updatedAt      DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)
  updatedByName  String?  @map("updated_by_name")

  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@map("event_plans")
}

/// Programação e cronograma: o que acontece, quando e onde.
model EventScheduleItem {
  id        String   @id @default(uuid()) @db.Uuid
  eventId   String   @map("event_id") @db.Uuid
  startsAt  DateTime @map("starts_at") @db.Timestamptz(3)
  endsAt    DateTime @map("ends_at") @db.Timestamptz(3)
  title     String
  location  String?
  speaker   String?
  notes     String?
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@index([eventId, startsAt])
  @@map("event_schedule_items")
}

enum EventPersonKind {
  ORGANIZER
  SPEAKER
  PARTICIPANT

  @@map("event_person_kind")
}

/// Responsáveis pela organização, palestrantes externos e participantes.
model EventPerson {
  id          String          @id @default(uuid()) @db.Uuid
  eventId     String          @map("event_id") @db.Uuid
  kind        EventPersonKind
  name        String
  /// Instituição (palestrante, participante) ou função (organização).
  affiliation String?
  contact     String?
  notes       String?
  /// Quem incluiu (o solicitante ou alguém da equipe).
  addedByName String?         @map("added_by_name")
  createdAt   DateTime        @default(now()) @map("created_at") @db.Timestamptz(3)

  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@index([eventId, kind, name])
  @@map("event_people")
}

enum TaskStatus {
  OPEN
  DONE

  @@map("task_status")
}

/// Pendências e tarefas da equipe. Com evento, são as pendências da organização
/// dele; sem evento, entram no checklist do dia (Fase 17).
model OperationalTask {
  id            String     @id @default(uuid()) @db.Uuid
  eventId       String?    @map("event_id") @db.Uuid
  title         String
  details       String?
  assigneeId    String?    @map("assignee_id") @db.Uuid
  assigneeName  String?    @map("assignee_name")
  dueDate       DateTime?  @map("due_date") @db.Date
  status        TaskStatus @default(OPEN)
  doneAt        DateTime?  @map("done_at") @db.Timestamptz(3)
  doneByName    String?    @map("done_by_name")
  createdById   String?    @map("created_by_id") @db.Uuid
  createdByName String     @map("created_by_name")
  createdAt     DateTime   @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt     DateTime   @updatedAt @map("updated_at") @db.Timestamptz(3)

  event     Event? @relation(fields: [eventId], references: [id], onDelete: Cascade)
  assignee  User?  @relation("TaskAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  createdBy User?  @relation("TaskCreator", fields: [createdById], references: [id], onDelete: SetNull)

  @@index([eventId, status])
  @@index([status, dueDate])
  @@map("operational_tasks")
}

/// Veículos para a liberação de vagas no estacionamento: quem pediu o evento
/// informa (antes ou depois da confirmação); a equipe também pode incluir.
model EventVehicle {
  id          String   @id @default(uuid()) @db.Uuid
  eventId     String   @map("event_id") @db.Uuid
  /// Placa sem traço, em maiúsculas: ABC1234 (antiga) ou ABC1D23 (Mercosul).
  plate       String
  model       String?
  driver      String?
  notes       String?
  addedByName String?  @map("added_by_name")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@unique([eventId, plate])
  @@map("event_vehicles")
}
