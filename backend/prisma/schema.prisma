// =============================================================================
// Sistema de Reserva de Salas — FMUSP
// Nomes no banco em snake_case (via @map/@@map); no código, camelCase.
//
// Regras que o Prisma NÃO consegue expressar (CHECKs, exclusão de sobreposição
// via btree_gist) ficam em migrations/20260921000100_db_constraints.
// =============================================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ----------------------------------------------------------------------------
// Enums
// ----------------------------------------------------------------------------

enum UserRole {
  USER // Solicitante
  ADMIN // SAD — Serviço de Apoio Didático
  NUCEV // Núcleo de Eventos: consulta tudo; no módulo de Eventos, cuida da análise ao encerramento

  @@map("user_role")
}

/// Que tipos de atividade a pessoa pode pedir (Fase 9). Graduação, Pós-Graduação
/// e Defesa só com a permissão; Cultura e Extensão e Concurso vêm ligados para
/// todos (o SAD pode tirar, ex.: de quem só cuida das defesas). Reunião não tem
/// permissão: todos pedem. O SAD concede e retira na tela Pessoas.
enum Permission {
  REQUEST_UNDERGRADUATE // pedir reservas de Graduação
  REQUEST_GRADUATE // pedir reservas de Pós-Graduação
  REQUEST_DEFENSE // pedir reservas de Defesa/Dissertação
  REQUEST_CULTURE_EXTENSION // pedir reservas de Cultura e Extensão (padrão)
  REQUEST_PUBLIC_EXAM // pedir reservas de Concurso (padrão)

  @@map("permission")
}

enum RoomType {
  AUDITORIUM // Auditório
  LABORATORY // Laboratório
  CLASSROOM // Sala de Aula
  MEETING_ROOM // Sala de Reunião
  MULTIPURPOSE // Espaço Multiuso
  COMPUTER_LAB // Sala de Informática
  BOARD_ROOM // Congregação/CTA
  THEATER // Teatro
  /// Átrio, hall, terraço, copa (Portaria 2794, Art. 3º): coffee break, exposição,
  /// credenciamento. Pode ficar sem capacidade mesmo Ativa (ex.: átrio).
  SUPPORT_AREA // Área de apoio

  @@map("room_type")
}

/// Tipo de cadeira, como na planilha do SAD (uma sala pode ter mais de um).
enum SeatType {
  SCHOOL // Escolar
  UNIVERSITY_FIXED // Universitária fixa
  UNIVERSITY_MOBILE // Universitária móvel

  @@map("seat_type")
}

enum RoomStatus {
  ACTIVE // Ativa
  MAINTENANCE // Em Manutenção
  INACTIVE // Inativa

  @@map("room_status")
}

enum ReservationStatus {
  PENDING // Pendente (já pré-bloqueia o horário)
  APPROVED // Aprovada
  REJECTED // Rejeitada (exige justificativa)
  CANCELLED // Cancelada

  @@map("reservation_status")
}

enum ActivityType {
  UNDERGRADUATE // Graduação
  GRADUATE // Pós-Graduação
  CULTURE_EXTENSION // Cultura e Extensão
  PUBLIC_EXAM // Concurso
  DEFENSE // Defesa/Dissertação
  ADMINISTRATIVE // Reunião / Administrativo (Portaria 2793, Art. 7º, itens 3 e 7)

  @@map("activity_type")
}

// ----------------------------------------------------------------------------
// Usuários
// ----------------------------------------------------------------------------

model User {
  id        String   @id @default(uuid()) @db.Uuid
  uspNumber String?  @unique @map("usp_number") // nº USP (loginUsuario da Senha Única)
  name      String
  email     String   @unique // sempre minúsculo; domínio validado no app e no banco
  role        UserRole     @default(USER)
  permissions Permission[] @default([REQUEST_CULTURE_EXTENSION, REQUEST_PUBLIC_EXAM])
  icalToken   String?      @unique @map("ical_token") // segredo do feed .ics; gerado sob demanda
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  reservations          Reservation[]       @relation("ReservationRequester")
  reviewedReservations  Reservation[]       @relation("ReservationReviewer")
  cancelledReservations Reservation[]       @relation("ReservationCanceller")
  series                ReservationSeries[]
  roomBlocks            RoomBlock[]
  noShowsMarked         Reservation[]       @relation("ReservationNoShowMarker")
  sanctions             UserSanction[]      @relation("SanctionedUser")
  sanctionsApplied      UserSanction[]      @relation("SanctionApplier")
  sanctionsLifted       UserSanction[]      @relation("SanctionLifter")
  auditLogs             AuditLog[]

  @@map("users")
}

// ----------------------------------------------------------------------------
// Salas e recursos
// ----------------------------------------------------------------------------

model Room {
  id             String     @id @default(uuid()) @db.Uuid
  name           String // nome/número da sala
  building       String // prédio/bloco
  floor          String // andar/pavimento (texto: "Térreo", "2º andar"...)
  /// Cadeiras da plateia. Pode ficar sem valor ("a definir") só em sala que
  /// não está Ativa (ex.: em reforma) ou em área de apoio sem limite cadastrado
  /// (ex.: átrio) — CHECK rooms_active_capacity_check.
  capacity       Int?
  roomType       RoomType   @map("room_type")
  status         RoomStatus @default(ACTIVE)
  /// Cadeiras de rodinha / professor / bancos, além das cadeiras da plateia (capacity).
  extraSeats     Int?       @map("extra_seats")
  /// Largura × comprimento, como na planilha da FMUSP (ex.: "10,30 × 9,60 m").
  dimensions     String?
  /// Outros equipamentos da sala, em texto livre. Só o SAD vê.
  equipmentNotes String?    @map("equipment_notes")
  seatTypes      SeatType[] @default([]) @map("seat_types")
  /// Porta de 900 mm.
  wideDoor       Boolean    @default(false) @map("wide_door")
  /// Sala preparada para atendimento especial.
  specialNeeds   Boolean    @default(false) @map("special_needs")
  /// Pode receber coffee break (Portaria 2794, Art. 5º: nas salas de aula, só
  /// as de uso interativo; doc. SAD/NUCEV §6: áreas de apoio). O SAD configura.
  coffeeAllowed         Boolean @default(false) @map("coffee_allowed")
  /// Máximo de pessoas no coffee break. Vazio = a capacidade do espaço.
  coffeeCapacity        Int?    @map("coffee_capacity")
  /// "Indicado para eventos acima de N pessoas" (ex.: átrios, acima de 250).
  /// É orientação de uso, não capacidade máxima.
  recommendedAbove      Int?    @map("recommended_above")
  /// O uso depende de autorização da Diretoria Executiva (átrios, Portaria 2747/2025).
  requiresBoardApproval Boolean @default(false) @map("requires_board_approval")
  /// Regras e condições de uso, em texto, para quem consulta o espaço.
  usageRules            String? @map("usage_rules")
  createdAt      DateTime   @default(now()) @map("created_at") @db.Timestamptz(3)

  resources    RoomResource[]
  photos       RoomPhoto[]
  reservations Reservation[]
  series       ReservationSeries[]
  blocks       RoomBlock[]

  @@unique([building, floor, name])
  @@index([status])
  @@map("rooms")
}

model Resource {
  id               String   @id @default(uuid()) @db.Uuid
  name             String   @unique
  description      String?
  /// O formulário de solicitação pede a quantidade (ex.: Computador, Chromebook).
  requestsQuantity Boolean  @default(false) @map("requests_quantity")
  /// Aparece no formulário de reserva. Itens de infraestrutura (nobreak, splitter…)
  /// ficam só no inventário das salas.
  requestable      Boolean  @default(true)
  /// Quando preenchido, o formulário pede um detalhe usando este texto de
  /// exemplo (ex.: "Ex.: Zoom, Teams, Google Meet" na Webconferência).
  detailPrompt     String?  @map("detail_prompt")
  /// Se não estiver vazia, o detalhe vira uma escolha entre estas opções, e
  /// passa a ser obrigatório (ex.: plataforma liberada no Bloqueio de internet).
  detailOptions    String[] @default([]) @map("detail_options")

  rooms RoomResource[]

  @@map("resources")
}

model RoomResource {
  roomId     String  @map("room_id") @db.Uuid
  resourceId String  @map("resource_id") @db.Uuid
  quantity   Int     @default(1)
  /// Modelo e patrimônio(s) do equipamento nesta sala — só o SAD vê.
  model      String?
  assetTags  String? @map("asset_tags")

  room     Room     @relation(fields: [roomId], references: [id], onDelete: Cascade)
  resource Resource @relation(fields: [resourceId], references: [id], onDelete: Cascade)

  @@id([roomId, resourceId])
  @@map("room_resources")
}

/// Foto de uma sala. As versões webp "thumb" e "large" (geradas no upload)
/// ficam no próprio banco: o app não depende de disco persistente no servidor.
model RoomPhoto {
  id         String   @id @default(uuid()) @db.Uuid
  roomId     String   @map("room_id") @db.Uuid
  caption    String?
  /// Ordem na galeria; a de menor posição é a capa.
  position   Int      @default(0)
  width      Int
  height     Int
  /// Arquivo de origem, quando veio do import (evita importar a mesma foto duas vezes).
  sourceName String?  @map("source_name")
  /// WebP de até 720 px (cards e miniaturas) e de até 1920 px (galeria).
  /// Nunca vêm nas listagens (roomPhotosInclude seleciona só os metadados).
  thumb      Bytes
  large      Bytes
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  room Room @relation(fields: [roomId], references: [id], onDelete: Cascade)

  @@unique([roomId, sourceName])
  @@index([roomId, position])
  @@map("room_photos")
}

// ----------------------------------------------------------------------------
// Reservas
// ----------------------------------------------------------------------------

/// Cabeçalho de uma reserva recorrente. As ocorrências são materializadas como
/// linhas em `reservations` (com series_id), o que permite validar conflito,
/// aprovar e cancelar data a data.
model ReservationSeries {
  id          String    @id @default(uuid()) @db.Uuid
  userId      String    @map("user_id") @db.Uuid
  roomId      String?   @map("room_id") @db.Uuid
  title       String
  description String
  rrule       String    @map("rrule_expression") // RFC 5545, sem DTSTART (ex.: FREQ=WEEKLY;BYDAY=MO)
  startTime   DateTime  @map("start_time") @db.Timestamptz(3) // DTSTART: início da 1ª ocorrência
  endTime     DateTime  @map("end_time") @db.Timestamptz(3) // fim da 1ª ocorrência (define a duração)
  untilDate   DateTime? @map("until_date") @db.Date
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  user         User          @relation(fields: [userId], references: [id], onDelete: Restrict)
  room         Room?         @relation(fields: [roomId], references: [id], onDelete: Restrict)
  reservations Reservation[]

  @@index([userId])
  @@map("reservation_series")
}

model Reservation {
  id                    String            @id @default(uuid()) @db.Uuid
  /// Nº de protocolo do pedido ("000123/2026"), gerado ao registrar (Portaria
  /// 2793, Art. 8º §1º, b). As datas de uma série compartilham o mesmo número.
  protocol              String
  seriesId              String?           @map("series_id") @db.Uuid
  userId                String            @map("user_id") @db.Uuid
  /// Sala pretendida/alocada. Nula quando o solicitante não indicou preferência;
  /// nesse caso nada é pré-bloqueado e o Admin precisa alocar antes de aprovar.
  roomId                String?           @map("room_id") @db.Uuid
  title                 String
  description           String
  /// Tipo de atividade e os campos específicos do formulário daquele tipo
  /// (validados por zod em src/schemas/reservation.ts). Nulos nas solicitações
  /// feitas antes dos formulários por tipo.
  activityType          ActivityType?     @map("activity_type")
  activityDetails       Json?             @map("activity_details")
  expectedAttendees     Int               @map("expected_attendees")
  requestedResources    Json              @default("[]") @map("requested_resources") // [{ resourceId, quantity?, detail? }]
  supportNotes          String?           @map("support_notes")
  termsAccepted         Boolean           @map("terms_accepted")
  /// Início e fim do uso do espaço. O início inclui a montagem (setupMinutes).
  startTime             DateTime          @map("start_time") @db.Timestamptz(3)
  endTime               DateTime          @map("end_time") @db.Timestamptz(3)
  /// Montagem antes da atividade, reservada junto (Portaria 2793, Art. 19):
  /// a atividade começa em startTime + setupMinutes.
  setupMinutes          Int               @default(0) @map("setup_minutes")
  /// Domingo, feriado, ponto facultativo ou fora das 07h–22h: só o SAD reserva,
  /// com autorização da Divisão Acadêmica (Art. 6º §1º). Libera o CHECK de horário.
  outsideRegularHours   Boolean           @default(false) @map("outside_regular_hours")
  /// Compromisso de não haver comércio nem consumo de bebidas alcoólicas (Art. 23).
  noAlcoholCommitment   Boolean           @default(false) @map("no_alcohol_commitment")
  /// Haverá coffee break/alimentação (Portaria 2794, Art. 5º: só em algumas salas).
  coffeeBreak           Boolean           @default(false) @map("coffee_break")
  /// Conferência do SAD ao confirmar Cultura e Extensão (CCEx, Divisão
  /// Acadêmica, taxa paga ou isenção — Art. 20 §3º, Art. 14 §3º, Art. 21 §2º).
  approvalChecklist     Json?             @map("approval_checklist")
  /// Não comparecimento sem cancelamento, registrado pelo SAD (Art. 9º §2º).
  noShowAt              DateTime?         @map("no_show_at") @db.Timestamptz(3)
  noShowById            String?           @map("no_show_by_id") @db.Uuid
  status                ReservationStatus @default(PENDING)
  rejectionReason       String?           @map("rejection_reason")
  reviewedById          String?           @map("reviewed_by_id") @db.Uuid
  reviewedAt            DateTime?         @map("reviewed_at") @db.Timestamptz(3)
  cancelledAt           DateTime?         @map("cancelled_at") @db.Timestamptz(3)
  /// Quem cancelou: o próprio solicitante ou alguém do SAD (que precisa dar o motivo).
  cancelledById         String?           @map("cancelled_by_id") @db.Uuid
  cancellationReason    String?           @map("cancellation_reason")
  /// Última alteração feita pelo SAD. Diferente da do solicitante, não devolve a
  /// reserva para análise: uma aprovada continua aprovada.
  modifiedByAdminAt     DateTime?         @map("modified_by_admin_at") @db.Timestamptz(3)
  /// Quando o solicitante alterou a reserva pela última vez. Alterar devolve a
  /// reserva para análise (PENDING); o SAD vê essas na aba "Alteradas".
  modifiedByRequesterAt DateTime?         @map("modified_by_requester_at") @db.Timestamptz(3)
  /// Como a reserva estava antes da alteração (status, horário, sala…), para o
  /// SAD comparar. Guarda o último estado revisado, não as edições intermediárias.
  previousSnapshot      Json?             @map("previous_snapshot")
  createdAt             DateTime          @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt             DateTime          @updatedAt @map("updated_at") @db.Timestamptz(3)

  series      ReservationSeries? @relation(fields: [seriesId], references: [id], onDelete: SetNull)
  user        User               @relation("ReservationRequester", fields: [userId], references: [id], onDelete: Restrict)
  room        Room?              @relation(fields: [roomId], references: [id], onDelete: Restrict)
  reviewedBy  User?              @relation("ReservationReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)
  cancelledBy User?              @relation("ReservationCanceller", fields: [cancelledById], references: [id], onDelete: SetNull)
  noShowBy    User?              @relation("ReservationNoShowMarker", fields: [noShowById], references: [id], onDelete: SetNull)

  @@index([roomId, startTime])
  @@index([userId, startTime])
  @@index([status])
  @@index([seriesId])
  @@index([protocol])
  @@map("reservations")
}

// ----------------------------------------------------------------------------
// Sanções aos solicitantes (Portaria 2793, Art. 9º §2º, Art. 11, Art. 17 e Art. 22)
// ----------------------------------------------------------------------------

enum SanctionType {
  WARNING // Advertência
  FINE // Multa
  SUSPENSION // Suspensão/bloqueio de novas reservas

  @@map("sanction_type")
}

model UserSanction {
  id          String       @id @default(uuid()) @db.Uuid
  userId      String       @map("user_id") @db.Uuid
  type        SanctionType
  reason      String
  /// Suspensão: último dia (inclusive). Nulo = até a regularização.
  until       DateTime?    @db.Date
  createdById String       @map("created_by_id") @db.Uuid
  createdAt   DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  /// Suspensão retirada antes do fim.
  liftedAt    DateTime?    @map("lifted_at") @db.Timestamptz(3)
  liftedById  String?      @map("lifted_by_id") @db.Uuid

  user      User  @relation("SanctionedUser", fields: [userId], references: [id], onDelete: Cascade)
  createdBy User  @relation("SanctionApplier", fields: [createdById], references: [id], onDelete: Restrict)
  liftedBy  User? @relation("SanctionLifter", fields: [liftedById], references: [id], onDelete: SetNull)

  @@index([userId, createdAt])
  @@map("user_sanctions")
}

// ----------------------------------------------------------------------------
// Notebooks do SAD (controle de patrimônio; não são reservados pelo sistema)
// ----------------------------------------------------------------------------

enum NotebookLocation {
  SAD // Backup no SAD
  NIT // Transferido para o NIT (TI da faculdade)

  @@map("notebook_location")
}

model Notebook {
  id        String           @id @default(uuid()) @db.Uuid
  assetTag  String           @unique @map("asset_tag")
  model     String?
  location  NotebookLocation
  notes     String?
  createdAt DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime         @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@map("notebooks")
}

// ----------------------------------------------------------------------------
// Regulamento (portarias) — aceito no "Li e concordo" do formulário. O SAD
// edita o texto e anexa os PDFs pela própria tela.
// ----------------------------------------------------------------------------

/// Linha única (id = 1, garantido por CHECK).
model Regulation {
  id          Int      @id @default(1)
  title       String
  /// Texto simples: parágrafos, "## título" e listas com "- ".
  body        String
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)
  updatedById String?  @map("updated_by_id") @db.Uuid

  @@map("regulation")
}

model RegulationFile {
  id        String   @id @default(uuid()) @db.Uuid
  fileName  String   @map("file_name")
  mimeType  String   @map("mime_type")
  size      Int
  data      Bytes
  position  Int      @default(0)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  @@map("regulation_files")
}

/// Bloqueio administrativo/manutenção de uma sala em um intervalo.
model RoomBlock {
  id          String   @id @default(uuid()) @db.Uuid
  roomId      String   @map("room_id") @db.Uuid
  createdById String   @map("created_by_id") @db.Uuid
  reason      String
  startTime   DateTime @map("start_time") @db.Timestamptz(3)
  endTime     DateTime @map("end_time") @db.Timestamptz(3)
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  room      Room @relation(fields: [roomId], references: [id], onDelete: Restrict)
  createdBy User @relation(fields: [createdById], references: [id], onDelete: Restrict)

  @@index([roomId, startTime])
  @@map("room_blocks")
}

// ----------------------------------------------------------------------------
// Histórico geral (Fase 9): quem fez o quê, quando, e o que mudou. Gravado na
// mesma transação da alteração (src/audit/log.ts); o sistema só acrescenta
// linhas, nunca altera nem apaga.
// ----------------------------------------------------------------------------

model AuditLog {
  id         String   @id @default(uuid()) @db.Uuid
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  /// Quem fez. Nulo = o próprio sistema (ou a pessoa foi excluída: o nome fica em actorName).
  actorId    String?  @map("actor_id") @db.Uuid
  actorName  String?  @map("actor_name")
  /// Ex.: "reservation.approve", "room.update" (lista em src/audit/log.ts).
  action     String
  /// "reservation", "room", "resource", "sanction", "regulation", "notebook", "user".
  entityType String   @map("entity_type")
  /// Reservas: o protocolo (as datas de uma série compartilham o número); demais: o id.
  entityId   String   @map("entity_id")
  /// Texto para a lista, gravado na hora (ex.: "000123/2026 — Aula de Anatomia").
  label      String?
  /// Só os campos que mudaram: { campo: { from, to } }.
  changes    Json?
  /// Contexto da ação: datas afetadas, motivo, escopo…
  details    Json?

  actor User? @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([entityType, entityId, createdAt])
  @@index([createdAt])
  @@index([actorId, createdAt])
  @@map("audit_logs")
}
